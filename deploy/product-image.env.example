# product-image-server(Go)env 样例 — 全部为占位符,真实值只进服务端密钥管理/服务器 env,不入 git。
# 建议部署: /etc/product-image/product-image.env (0640)

# --- 本产品 ---
PRODUCT_SERVER_ADDR=127.0.0.1:18220
PRODUCT_DB_PATH=/var/lib/product-image/product-image.db
PRODUCT_INTERNAL_TOKEN=<产品内部凭据:web BFF -> Go server,随机 32 字节以上>

# --- platform-identity(必需)---
PLATFORM_IDENTITY_BASE_URL=http://127.0.0.1:18101
PLATFORM_IDENTITY_APP_ID=product-image
PLATFORM_IDENTITY_TOKEN=<IDENTITY_APP_TOKENS 中本 app 专用 token>
# 可选:平台侧签发方标识,配置后本地校验 iss
PLATFORM_IDENTITY_ISSUER=

# --- platform-upload(FEATURE_GENERATION_ENABLED=1 时必需)---
PLATFORM_UPLOAD_BASE_URL=http://127.0.0.1:18104
PLATFORM_UPLOAD_TOKEN=<UPLOAD_APP_TOKENS 中本 app 专用 token>

# --- platform-task(FEATURE_GENERATION_ENABLED=1 时必需)---
PLATFORM_TASK_BASE_URL=http://127.0.0.1:18103
PLATFORM_TASK_TOKEN=<TASK_APP_TOKENS 中本 app 专用 token>

# --- platform-billing(ECO_BILLING_ENABLED=1 时必需)---
PLATFORM_BILLING_BASE_URL=http://127.0.0.1:18102
PLATFORM_BILLING_TOKEN=<BILLING_APP_TOKENS 中本 app 专用 token>

# --- 跨应用回执投递(HUI-1745,共测缺陷 D-A1 修复)---
# 对端 guanlan-order 内部通道令牌(即对端 env 的 INTERNAL_TOKEN,原样填入)。
# 非空时回执投递加发 Authorization: Bearer <此值>;为空时不发该头
# (接收端 401 → 回执 failed,可用 /receipts/{id}/resend 重投)。
PRODUCT_ORDER_INTERNAL_TOKEN=<guanlan-order INTERNAL_TOKEN,真实值禁止入库>

# --- 开关(默认全 off;收费与生成能力分别控制)---
ECO_BILLING_ENABLED=0
FEATURE_GENERATION_ENABLED=0
# 电商尺寸适配(HUI-1703 FEAT-0204):纯确定性变换,不触生成/计费。
# off 时尺寸适配路由不注册(404 不可见);开启需 platform-upload 可用(变体登记)。
FEATURE_SIZE_ADAPT=0
# 可选:自定义预设集 JSON 覆盖内嵌公开常见规格整理(结构见
# server/internal/sizeadapt/README.md;以各平台当时官方要求为准)。
# PRODUCT_SIZE_PRESETS=/etc/product-image/size-presets.json
# 产品图模板库(HUI-1705 FEAT-0206):登记制开关,沿 size_adapt 语义。
# 模板=确定性预设+参数引用集,零触发生成;off 时模板路由不注册(404 不可见)。
FEATURE_TEMPLATES=0
# AI 背景替换(HUI-1699 FEAT-0200)。off 时路由不注册(404)。
# 创意模式另需 FEATURE_BG_CREATIVE=1 且生成任务服务可用;默认关闭。
# 没有平台报价金额时界面显示「计费待确认」。本开关不代表生产出图已通过。
FEATURE_BG_REPLACE=0
FEATURE_BG_CREATIVE=0
# 真实背景模型凭证。留空时接口保持「真实出图未完成」，禁止把任务受理写成出图成功。
# 真实值只放服务器环境，禁止入库。示例不提供假凭证。
# PRODUCT_BG_MODEL_CREDENTIAL=
# 光影场景(HUI-1700 FEAT-0201)。off 时路由不注册(404)。
# 不能绕过主体保护。没有供应商回执时结果是失败或待核对。
# 没有平台报价金额时界面显示「计费待确认」。本开关不代表生产出图已通过。
FEATURE_LIGHT_SCENE=0
FEATURE_LIGHT_CREATIVE=0
# 真实光影模型凭证。留空时生成失败关闭，文案为真实出图未完成。
# 真实值只放服务器环境，禁止入库。示例不提供假凭证。
# PRODUCT_LIGHT_MODEL_CREDENTIAL=
# 主体保真记录(HUI-1698 FEAT-0199):只记录保护范围与检查,不调用生成、不扣费。
# off 时路由不注册(404)。开启后真实生成保真仍为待确认,不能写成已经通过。
FEATURE_SUBJECT_FIDELITY=0
# 展示视频(HUI-1702 FEAT-0203):默认开放。已有产品图才能发起,运镜只有 360 度或场景运镜。
# 没有真实视频供应商时结果是失败或待确认,不播放静图或假视频,不扣费。
# off 时路由不注册(404)。本开关不代表 Billing 或 Production 已通过。
FEATURE_SHOWCASE_VIDEO=1

# --- 正式来源生成(HUI-2232;默认关闭新建,旧记录 read/recovery 不受此开关阻断)---
# 上述四项 app 专用凭据必须彼此不同;内部 base 必须为合法 loopback http(s)。
# 不填 QA 价格或隐式下载主机。关闭新建不会清空已付费事实/待回收引用。
FEATURE_SOURCE_IMAGES=0
FEATURE_SOURCE_ORG_IMAGES=0
PRODUCT_SOURCE_PRICING_VERSION=
# 明确 OSS 下载主机白名单(仅主机名,逗号分隔);留空只恢复事实和既有回收队列,
# Asset Verify/下载失败关闭,不宣告完整输出恢复 ready。
PRODUCT_SOURCE_DOWNLOAD_HOSTS=

# --- 限定保真换背景(HUI-2232 C2;默认关闭)---
# 开启还需要:上面的正式来源生成已就绪、付款人为个人、样本集装载并校验通过。
# 样本集是仓库内的冻结合成样本(fixtures/frozen-samples/v1),部署时把该目录放到服务器并在此指向它。
# 样本集缺失 / 被改动 / 校验不过只会关闭本模式(能力端点给出原因),不会让进程退出。
FEATURE_BG_PLATE_LOCK=0
PRODUCT_FIDELITY_SAMPLES_DIR=

# --- 锁定商品，只改这里(HUI-2596;默认关闭)---
# off 时路由不注册(404)。on 也不调用供应商：没有密钥时只用确定性底板锁回主体。
# 真实供应商局部编辑仍是 UNKNOWN。增量费用由服务端按整数分返回，前端不得再加一次。
FEATURE_SELECTIVE_REVISION=0

# --- 已采用商品的 Motion 引用(HUI-2746;默认关闭)---
# off 时路由不注册(404)。on 也只形成引用声明：不生成视频，不调用供应商，不复制 Motion 编辑器。
# 未核验的引用不是动态广告，文案写明还没生成成片。
# HUI-2732 未完成。不能证明其他变体执行次数为 0 时不批量重跑。
FEATURE_MOTION_PRODUCT=0
