# product-image-web(Next.js BFF)env 样例 — 全部为占位符,真实值不入 git。
# 浏览器永不接触本文件里的值;BFF 服务端只调 Go server loopback。

# Go server(同机 loopback)
PRODUCT_SERVER_BASE_URL=http://127.0.0.1:18220
PRODUCT_SERVER_TOKEN=<与 server 端 PRODUCT_INTERNAL_TOKEN 相同的产品内部凭据>

# 会话 Cookie 安全属性:HTTPS 部署时置 1
PRODUCT_COOKIE_SECURE=0
